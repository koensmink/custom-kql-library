Usage
| where TimeGenerated >= ago(15d)
| where StartTime >= startofday(ago(14d))
    and EndTime <= startofday(now())
| where DataType in (
    "SigninLogs", "AuditLogs",
    "SecurityEvent", "WindowsEvent", "AzureActivity",
    "BehaviorAnalytics", "IdentityInfo",
    "UserPeerAnalytics", "Anomalies"
)
| summarize
    TotaalGB = sum(Quantity) / 1000.0,
    FactureerbaarGB = sumif(Quantity, IsBillable == true) / 1000.0
    by DataType, Plan
| project
    Tabel = DataType,
    Plan,
    GemiddeldGBPerDag = round(TotaalGB / 14.0, 4),
    FactureerbaarGBPerDag = round(FactureerbaarGB / 14.0, 4),
    ProjectieFactureerbaarGB30Dagen =
        round(FactureerbaarGB / 14.0 * 30.0, 3)
| order by Tabel asc
